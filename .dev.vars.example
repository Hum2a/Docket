# Local Wrangler secrets (gitignored as .dev.vars)
# Copy to .dev.vars and fill in values:
#   cp .dev.vars.example .dev.vars

DATABASE_URL=
API_KEY=dev-local-key-change-me

# Optional — job digests
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM=

# Optional — outreach (required before real sends)
OUTREACH_FROM=
OUTREACH_REPLY_TO=
OUTREACH_POSTAL_ADDRESS=

# Optional — auto-generated by: npm run secrets:local
RESEND_INBOUND_SECRET=
UNSUBSCRIBE_SIGNING_KEY=
